# =====================================================================
# Configuración del Entorno - My RSS App
# Copia este archivo como .env para desarrollo local o configura estas
# variables en el panel de Coolify.
# =====================================================================

# 1. Base de Datos PostgreSQL
# URL de conexión (formato: postgresql://usuario:contraseña@host:5432/nombre_db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rss_app_db

# 2. Webhook IFTTT (Opcional si no usas automatizaciones externas)
# URL de webhook completa de IFTTT Maker Event
IFTTT_WEBHOOK_URL=https://maker.ifttt.com/trigger/new_rss_entry/with/key/TU_IFTTT_KEY

# 3. Servidor Web y Rutas
# Directorio para almacenar feed.xml persistente (en Docker/Coolify: /data)
FEED_DIR=/data
PORT=8080
HOST=0.0.0.0
# URL pública del feed (para el encabezado del canal XML en lectores RSS)
APP_URL=https://my-rss-app.tudominio.com

# 4. Tiempos Operativos (en segundos)
# Intervalo de sondeo de RSS (600s = 10 minutos)
INTERVAL=600
# Delay entre publicaciones a IFTTT (225s para respetar límites de tasa)
POST_DELAY=225

# 5. Seguridad del Panel y API (Protección de escritura en BD y config.yaml)
ADMIN_TOKEN=cambia_este_token_seguro

